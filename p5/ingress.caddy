# Legacy entry points preserve paths while sending visitors to the owning entity.
https://wallet-p2.demo.inoerawan.id:8443 {
    tls /tls/fullchain.pem /tls/privkey.pem
    header Cache-Control no-store
    header Referrer-Policy no-referrer
    redir https://dompet-identitas.demo.inoerawan.id{uri} 308
}

# Legacy entry points preserve paths while sending visitors to the owning entity.
