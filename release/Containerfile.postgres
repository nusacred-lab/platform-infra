ARG POSTGRES_IMAGE
FROM ${POSTGRES_IMAGE}
# Alpine backports fix musl CVE-2026-107891 and Brotli CVE-2026-111497.
RUN apk add --no-cache musl=1.2.6-r3 musl-utils=1.2.6-r3 ca-certificates-bundle=20261020-r0 libcrypto3=3.5.9-r0 libssl3=3.5.9-r0 zlib=1.3.2-r1 brotli-libs=1.2.1-r0 && rm /usr/local/bin/gosu
USER postgres
