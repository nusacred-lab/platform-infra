# Keep the pinned Keycloak distribution and replace the vulnerable UBI OS/JDK runtime.
ARG KEYCLOAK_IMAGE
ARG JVM_RUNTIME_IMAGE
FROM ${KEYCLOAK_IMAGE} AS distribution
FROM ${JVM_RUNTIME_IMAGE}
USER 0:0
COPY --from=distribution --chown=1000:0 /opt/keycloak/ /opt/keycloak/
ENV KC_DB=postgres KC_HEALTH_ENABLED=true KC_METRICS_ENABLED=false HOME=/opt/keycloak
WORKDIR /opt/keycloak
USER 1000:0
RUN /opt/keycloak/bin/kc.sh build --cache=local
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
